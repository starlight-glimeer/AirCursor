{
  "name": "aircursor",
  "version": "0.9.97",
  "description": "macOS 上的动态壁纸播放器 —— 直接用 Wallpaper Engine 创意工坊的壁纸",
  "author": "starlight-glimeer",
  "main": "wallpaper/src/main.js",
  "scripts": {
    "start": "bash wallpaper/scripts/check-tree.sh; electron .",
    "web": "node server.js",
    "check": "node --check electron/main.js && node --check public/pose.js && node --check public/motion.js && node --check public/tracking.js && for f in wallpaper/src/*.js; do node --check $f || exit 1; done",
    "dist:mac": "bash wallpaper/scripts/build-mac.sh",
    "build:mac": "bash wallpaper/scripts/build-mac.sh",
    "test": "node wallpaper/test/run.js",
    "vendor": "bash wallpaper/scripts/fetch-vendor.sh",
    "postinstall": "bash wallpaper/scripts/fetch-vendor.sh",
    "sync": "git pull --ff-only && npm install --silent && bash wallpaper/scripts/fingerprint.sh",
    "fingerprint": "bash wallpaper/scripts/fingerprint.sh",
    "whatswrong": "bash wallpaper/scripts/whatswrong.sh",
    "restore-gestures": "bash wallpaper/scripts/restore-gestures.sh"
  },
  "build": {
    "appId": "com.starlightglimeer.aircursor",
    "productName": "GestureWall",
    "asar": false,
    "files": [
      "wallpaper/**/*",
      "public/pose.js",
      "public/motion.js",
      "public/tracking.js",
      "public/vendor/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/AirCursorPointer.swift",
        "to": "native/AirCursorPointer.swift"
      },
      {
        "from": "native/AirCursorVoice.swift",
        "to": "native/AirCursorVoice.swift"
      },
      {
        "from": "native/AirCursorVoiceInfo.plist",
        "to": "native/AirCursorVoiceInfo.plist"
      },
      {
        "from": "wallpaper/native/GestureWallMouse.swift",
        "to": "native/GestureWallMouse.swift"
      },
      {
        "from": "wallpaper/native/GestureWallAudio.swift",
        "to": "native/GestureWallAudio.swift"
      },
      {
        "from": "dist/prebuilt-helpers",
        "to": "prebuilt-helpers"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSHumanReadableCopyright": "由 starlight-glimeer 开发 · GestureWall",
        "NSCameraUsageDescription": "GestureWall 需要摄像头来识别你的手势。画面只在本机处理，不上传、不保存。",
        "NSMicrophoneUsageDescription": "GestureWall 需要麦克风来识别语音指令（可选功能）。",
        "NSSpeechRecognitionUsageDescription": "GestureWall 需要语音识别来处理你的语音指令（可选功能，本机识别）。",
        "NSAppleEventsUsageDescription": "GestureWall 需要本机自动化来打开你指定的应用、以及设置桌面壁纸。",
        "NSScreenCaptureUsageDescription": "GestureWall 需要采集系统声音来驱动音频响应的壁纸。"
      },
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "wallpaper/build/icon.icns"
    },
    "dmg": {
      "icon": "wallpaper/build/icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/hands": "^0.4.1675469240"
  }
}
